# Copy to .env and fill in. Never commit .env.
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:4321"]

# Without a key the agent runs in offline (echo) mode.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Building assistant (AriNav chat/voice): uses ANTHROPIC_API_KEY with this model and effort.
ASSISTANT_MODEL=claude-sonnet-5-5
ASSISTANT_EFFORT=medium
# ElevenLabs speech-to-text / text-to-speech for push-to-talk. Without a key voice is off.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# Claude Managed Agents. Create once with: uv run python -m scripts.setup_managed_agent
MANAGED_AGENT_ID=
MANAGED_AGENT_ENVIRONMENT_ID=

# Ingestion: folder of datasets (default: backend/data/datasets).
# DATASETS_DIR=../problem_statement/industrial-agents-hackathon-2026/data/dev

# LangSmith tracing (https://smith.langchain.com). Tracing is on only when LANGSMITH_TRACING=true AND a key is set.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=mm-industrial-26
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
